{
  "watch": [
    "src",
    "homebridge-ui/server.js",
    "homebridge-ui/public/app.js",
    "homebridge-ui/public/index.html",
    "homebridge-ui/public/styles.css"
  ],
  "ext": "ts,js,json,html,css",
  "ignore": ["homebridge-ui/public/lib/**"],
  "exec": "pnpm run build && pnpm run start",
  "signal": "SIGTERM"
}
