{
  "pluginAlias": "ElgatoKeyLights",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Elgato Key Lights",
        "description": "Plugin name as displayed in the homebridge log"
      },
      "pollingRate": {
        "title": "Polling Rate (in milliseconds)",
        "type": "integer",
        "required": false,
        "placeholder": 5000,
        "description": "Delay between successful status refreshes in milliseconds (default 5000). Requests do not overlap.",
        "minimum": 500,
        "maximum": 60000
      },
      "powerOnBehavior": {
        "title": "Power On Behaviour",
        "type": "number",
        "required": false,
        "placeholder": 1,
        "oneOf": [
          {
            "title": "Restore last settings used",
            "enum": [1]
          },
          {
            "title": "Restore default settings",
            "enum": [2]
          }
        ],
        "description": "The behaviour when powering the lights on"
      },
      "powerOnBrightness": {
        "title": "Default Power On Brightness (in percent)",
        "type": "integer",
        "required": false,
        "placeholder": 20,
        "minimum": 0,
        "maximum": 100,
        "description": "The default brightness setting of the lights"
      },
      "powerOnTemperature": {
        "title": "Default Power On Colour Temperature (in Kelvin)",
        "type": "integer",
        "required": false,
        "placeholder": 4695,
        "minimum": 2900,
        "maximum": 7000,
        "step": 50,
        "description": "The default colour temperature setting of the lights"
      },
      "switchOnDurationMs": {
        "title": "Switch On Duration (in milliseconds)",
        "type": "integer",
        "required": false,
        "description": "The duration of the switch on sequence",
        "minimum": 0,
        "maximum": 60000
      },
      "switchOffDurationMs": {
        "title": "Switch Off Duration (in milliseconds)",
        "type": "integer",
        "required": false,
        "placeholder": 300,
        "description": "The duration of the switch off sequence",
        "minimum": 0,
        "maximum": 60000
      },
      "colorChangeDurationMs": {
        "title": "Colour Change Duration (in milliseconds)",
        "type": "integer",
        "required": false,
        "placeholder": 100,
        "description": "The duration of the colour change sequence",
        "minimum": 0,
        "maximum": 60000
      },
      "useIP": {
        "title": "Use IP address instead of hostname",
        "type": "boolean",
        "required": false,
        "description": "Prefer advertised IP addresses over the hostname. Both remain connection candidates for recovery."
      },
      "devices": {
        "title": "Devices",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "required": false
            },
            "mac": {
              "title": "MAC Address",
              "type": "string",
              "required": false,
              "description": "MAC address or serial number is required. Discovery supplies the MAC; manual add verifies the serial."
            },
            "host": {
              "title": "Hostname",
              "type": "string"
            },
            "ip": {
              "title": "IP Address",
              "type": "string"
            },
            "port": {
              "title": "Port",
              "type": "integer",
              "default": 9123,
              "minimum": 1,
              "maximum": 65535
            },
            "model": {
              "title": "Model",
              "type": "string"
            },
            "displayName": {
              "title": "Display Name",
              "type": "string",
              "description": "Custom name for HomeKit"
            },
            "powerOnBehavior": {
              "title": "Power On Behaviour",
              "type": "number",
              "oneOf": [
                {
                  "title": "Use global setting",
                  "enum": [0]
                },
                {
                  "title": "Restore last settings used",
                  "enum": [1]
                },
                {
                  "title": "Restore default settings",
                  "enum": [2]
                }
              ],
              "default": 0
            },
            "powerOnBrightness": {
              "title": "Default Brightness (%)",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "powerOnTemperature": {
              "title": "Default Temperature (K)",
              "type": "integer",
              "minimum": 2900,
              "maximum": 7000
            },
            "enabled": {
              "title": "Enabled",
              "type": "boolean",
              "default": true
            },
            "serialNumber": {
              "title": "Serial number",
              "type": "string",
              "minLength": 1,
              "description": "Stable device serial. Manual add fills this from the light. Required when no MAC is configured."
            }
          },
          "anyOf": [
            {
              "required": ["mac"],
              "properties": {
                "mac": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "required": ["serialNumber"],
              "properties": {
                "serialNumber": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      "requestTimeout": {
        "title": "Request timeout (milliseconds)",
        "type": "integer",
        "minimum": 100,
        "maximum": 10000,
        "placeholder": 3000,
        "description": "Deadline for each HTTP request (default 3000)."
      },
      "retryMaxDelay": {
        "title": "Maximum retry delay (milliseconds)",
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000,
        "placeholder": 60000,
        "description": "Maximum delay between failed recovery attempts (default 60000). Recovery continues indefinitely."
      }
    }
  },
  "layout": [
    "name",
    "pollingRate",
    {
      "type": "fieldset",
      "title": "Durations",
      "expandable": true,
      "expanded": false,
      "items": ["switchOnDurationMs", "switchOffDurationMs", "colorChangeDurationMs"]
    },
    {
      "type": "fieldset",
      "title": "Power On Behaviour",
      "expandable": true,
      "expanded": false,
      "items": ["powerOnBehavior", "powerOnBrightness", "powerOnTemperature"]
    },
    {
      "type": "fieldset",
      "title": "Advanced",
      "expandable": true,
      "expanded": false,
      "items": ["requestTimeout", "retryMaxDelay", "useIP"]
    }
  ]
}
