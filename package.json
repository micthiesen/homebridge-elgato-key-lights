{
  "displayName": "Elgato Key Lights",
  "name": "@micthiesen/homebridge-elgato-key-lights",
  "version": "1.1.0",
  "description": "A Homebridge plugin for Elgato Key Light and Key Light Air",
  "author": "Michael Thiesen",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micthiesen/homebridge-elgato-key-lights.git"
  },
  "bugs": {
    "url": "https://github.com/micthiesen/homebridge-elgato-key-lights/issues"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "oxlint --report-unused-disable-directives --deny-warnings .",
    "watch": "pnpm run dev",
    "copy:ui-assets": "node scripts/copy-ui-assets.mjs",
    "build": "pnpm run copy:ui-assets && node scripts/clean.mjs && tsc",
    "prepublishOnly": "pnpm run check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:runtime",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "format": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "check": "pnpm run lint && pnpm run format",
    "check:write": "oxlint --fix --report-unused-disable-directives . && oxfmt --write .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:only": "vitest run",
    "dev": "pnpm run build && nodemon",
    "start": "homebridge --plugin-path . -U ./test/hbConfig -D",
    "test:runtime": "node scripts/smoke-runtime.mjs"
  },
  "keywords": [
    "homebridge-plugin",
    "elgato",
    "keylight",
    "key lights",
    "key light air",
    "streaming",
    "keylight air"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "bonjour-service": "^1.4.4",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@mp-consulting/homebridge-ui-kit": "^1.0.1",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ],
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public"
  }
}
